# Copy to .env and fill in. Never commit .env.

# --- Gnani (one key covers STT and TTS): https://app.gnani.ai/voice ---
GNANI_API_KEY=
GNANI_STT_LANGUAGE=en-IN
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_VOICE_HINGLISH=Poorvi

# --- LLM: pick one provider ---
# Anthropic
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# OpenAI-compatible (OpenAI, Gemini, Groq, OpenRouter, Ollama):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash

# --- Dataset location (default: ./Capstone_Project_Dataset_FTTT_2026 next to this repo) ---
# DATASET_DIR=D:/path/to/Capstone_Project_Dataset_FTTT_2026

# --- Optional dense retrieval (needs sentence-transformers) ---
# EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
